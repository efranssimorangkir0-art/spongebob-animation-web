:root {
  --sky-top: #53d9ff;
  --sky-mid: #7de4ff;
  --sky-bottom: #dffcff;
  --ocean: #1db0d4;
  --ocean-deep: #0f7fa4;
  --sponge: #f9eb74;
  --sponge-dark: #eacb52;
  --sponge-shadow: #d8b543;
  --pants: #f5d263;
  --white: #ffffff;
  --dark: #0f2d3f;
  --pink: #ff8fb1;
  --seafoam: #8df0d0;
  --card: rgba(255, 255, 255, 0.28);
  --line: rgba(255, 255, 255, 0.35);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Fredoka', sans-serif;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 28%, var(--sky-bottom) 100%);
  color: var(--dark);
  min-height: 100vh;
}

button,
a {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at top, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 30%),
    linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 35%, var(--sky-bottom) 100%);
}

.background-ocean {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bubble {
  position: absolute;
  bottom: -40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.45);
  animation: bubbleRise 9s linear infinite;
}

.bubble-1 { left: 12%; width: 22px; height: 22px; animation-delay: 0s; }
.bubble-2 { left: 28%; width: 30px; height: 30px; animation-delay: 1.6s; }
.bubble-3 { left: 48%; width: 18px; height: 18px; animation-delay: 3.2s; }
.bubble-4 { left: 66%; width: 28px; height: 28px; animation-delay: 5.2s; }
.bubble-5 { left: 82%; width: 24px; height: 24px; animation-delay: 2.8s; }

@keyframes bubbleRise {
  0% {
    transform: translateY(0) scale(0.7);
    opacity: 0;
  }
  15% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(-110vh) scale(1.3);
    opacity: 0;
  }
}

.topbar {
  position: relative;
  z-index: 2;
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  padding: 28px 0 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: 'Baloo 2', cursive;
  font-weight: 800;
  font-size: clamp(1.2rem, 2vw, 2rem);
  color: var(--white);
  text-shadow: 0 4px 18px rgba(14, 76, 120, 0.28);
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(180deg, #fff8af 0%, #f7d95a 100%);
  color: #f58f1f;
  box-shadow: 0 8px 20px rgba(255, 190, 58, 0.4);
}

.nav {
  display: flex;
  align-items: center;
  gap: 26px;
}

.nav a {
  text-decoration: none;
  color: var(--white);
  font-weight: 600;
  opacity: 0.92;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.nav a:hover {
  transform: translateY(-2px);
  opacity: 1;
}

.hero {
  position: relative;
  z-index: 2;
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  min-height: calc(100vh - 110px);
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  align-items: center;
  gap: 28px;
}

.hero-copy {
  padding: 30px 0 10px;
}

.eyebrow {
  margin: 0 0 14px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.75rem;
  font-weight: 700;
  color: rgba(15, 45, 63, 0.8);
}

.hero-copy h1 {
  margin: 0;
  font-family: 'Baloo 2', cursive;
  font-size: clamp(3rem, 6vw, 6.2rem);
  line-height: 0.92;
  color: var(--dark);
}

.hero-copy h1 span {
  color: #ff9d1f;
  text-shadow: 0 6px 18px rgba(255, 155, 31, 0.2);
}

.description {
  max-width: 560px;
  margin: 20px 0 0;
  font-size: 1.08rem;
  line-height: 1.75;
  color: rgba(15, 45, 63, 0.78);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 32px;
}

button {
  border: none;
  border-radius: 999px;
  padding: 16px 26px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

button:hover {
  transform: translateY(-2px) scale(1.01);
}

.primary {
  background: linear-gradient(180deg, #ffca36 0%, #ff9d1f 100%);
  color: #fff;
  box-shadow: 0 14px 30px rgba(255, 156, 26, 0.35);
}

.secondary {
  background: rgba(255, 255, 255, 0.5);
  color: var(--dark);
  border: 1px solid rgba(15, 45, 63, 0.12);
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 36px;
}

.stats div {
  min-width: 120px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stats strong {
  font-family: 'Baloo 2', cursive;
  font-size: 1.8rem;
  line-height: 1;
  color: var(--dark);
}

.stats span {
  font-size: 0.82rem;
  color: rgba(15, 45, 63, 0.72);
}

.character-scene {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 560px;
}

.shadow {
  position: absolute;
  width: 340px;
  height: 52px;
  bottom: 58px;
  border-radius: 50%;
  background: rgba(16, 94, 130, 0.22);
  filter: blur(10px);
  animation: floatShadow 3.5s ease-in-out infinite;
}

.spongebob {
  position: relative;
  width: 320px;
  height: 420px;
  animation: bobUpDown 3s ease-in-out infinite;
}

.body {
  position: absolute;
  left: 50%;
  top: 24px;
  width: 220px;
  height: 220px;
  background: linear-gradient(180deg, #fff7a8 0%, var(--sponge) 35%, var(--sponge-dark) 100%);
  border-radius: 50% 50% 45% 45%;
  transform: translateX(-50%);
  box-shadow:
    inset -18px -12px 0 rgba(255, 255, 255, 0.15),
    inset 18px 18px 0 rgba(255, 255, 255, 0.16),
    0 28px 40px rgba(255, 180, 33, 0.22);
  border: 6px solid rgba(255,255,255,0.28);
}

.eye {
  position: absolute;
  top: 54px;
  width: 44px;
  height: 56px;
  border-radius: 50%;
  background: var(--white);
  border: 5px solid rgba(12, 49, 73, 0.1);
}

.eye.left { left: 42px; }
.eye.right { right: 42px; }

.pupil {
  position: absolute;
  width: 12px;
  height: 12px;
  background: #212121;
  border-radius: 50%;
  top: 18px;
  left: 14px;
  animation: blink 6s infinite;
}

.nose {
  position: absolute;
  left: 50%;
  top: 92px;
  width: 14px;
  height: 20px;
  background: #f7d27a;
  border-radius: 50%;
  transform: translateX(-50%);
}

.mouth {
  position: absolute;
  left: 50%;
  top: 122px;
  width: 92px;
  height: 52px;
  border: 6px solid #ea6c4d;
  border-top: 0;
  border-radius: 0 0 60px 60px;
  transform: translateX(-50%);
}

.cheek {
  position: absolute;
  top: 118px;
  width: 18px;
  height: 18px;
  background: rgba(255, 121, 145, 0.75);
  border-radius: 50%;
}

.cheek.left { left: 24px; }
.cheek.right { right: 24px; }

.arm {
  position: absolute;
  top: 180px;
  width: 72px;
  height: 32px;
  background: linear-gradient(180deg, #f3df7d 0%, #f0cc58 100%);
  border-radius: 30px;
  box-shadow: inset -10px -8px 0 rgba(255,255,255,0.1);
}

.arm.left {
  left: -18px;
  transform: rotate(18deg);
  animation: armSwingLeft 2.4s ease-in-out infinite;
}

.arm.right {
  right: -18px;
  transform: rotate(-18deg);
  animation: armSwingRight 2.4s ease-in-out infinite;
}

.leg {
  position: absolute;
  bottom: 46px;
  width: 60px;
  height: 90px;
  border-radius: 24px;
  background: linear-gradient(180deg, #ffeb7a 0%, #f3d05b 100%);
}

.leg.left { left: 80px; }
.leg.right { right: 80px; }

.leg::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -12px;
  width: 74px;
  height: 24px;
  transform: translateX(-50%);
  border-radius: 16px;
  background: rgba(255,255,255,0.3);
}

@keyframes bobUpDown {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-18px); }
}

@keyframes armSwingLeft {
  0%, 100% { transform: rotate(18deg); }
  50% { transform: rotate(38deg); }
}

@keyframes armSwingRight {
  0%, 100% { transform: rotate(-18deg); }
  50% { transform: rotate(-38deg); }
}

@keyframes blink {
  0%, 45%, 48%, 100% { transform: scaleY(1); }
  46%, 47% { transform: scaleY(0.15); }
}

@keyframes floatShadow {
  0%, 100% { transform: scaleX(1); opacity: 0.22; }
  50% { transform: scaleX(1.12); opacity: 0.3; }
}

.features {
  position: relative;
  z-index: 2;
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto 60px;
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 22px;
}

.feature-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 28px 24px;
  backdrop-filter: blur(10px);
  box-shadow: 0 20px 40px rgba(18, 88, 120, 0.12);
}

.icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.3) 100%);
  font-size: 2rem;
  margin-bottom: 18px;
}

.feature-card h3 {
  margin: 0;
  font-size: 1.5rem;
  color: var(--dark);
}

.feature-card p {
  margin: 14px 0 0;
  color: rgba(15, 45, 63, 0.75);
  line-height: 1.7;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding-bottom: 10px;
  }

  .hero-copy {
    text-align: center;
    padding-top: 10px;
  }

  .description {
    margin-left: auto;
    margin-right: auto;
  }

  .actions,
  .stats {
    justify-content: center;
  }

  .features {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .topbar {
    padding-top: 18px;
  }

  .nav {
    display: none;
  }

  .hero-copy h1 {
    font-size: 2.8rem;
  }

  .spongebob {
    transform: scale(0.82);
  }
}
